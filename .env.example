# K.H.A.V.I.S. environment variables
#
# Copy this file to .env and fill in the keys you have access to. Pools
# whose env var is left blank are gracefully skipped by the integration
# test runner (`scripts/integration_test.py`).

# --- MiniMax-M3 (token plan, OpenAI-compatible) -------------------
# Coding-plan key (sk-cp-…). Used by providers/MiniMax.py and by Codex
# (config.toml → model_providers.minimax).
MINIMAX_API_KEY=

# --- MiMo-Code (MiMo token plan, Anthropic Messages) --------------
# Bearer token (tp-…). Must be set explicitly: providers/mimo.py does NOT
# fall back to ANTHROPIC_AUTH_TOKEN (that token may belong to another relay).
MIMO_AUTH_TOKEN=

# --- GLM-5.3 (ZhipuAI / BigModel) ---------------------------------
# Used by providers/glm.py
ZHIPUAI_API_KEY=

# --- Google Gemini (Flash + Pro) -----------------------------------
# Single key serves both gemini-flash-latest and gemini-pro-latest.
# Used by providers/gemini.py
GOOGLE_API_KEY=

# --- NVIDIA Cloud (NIM) --------------------------------------------
# Used by providers/nvidia.py
NVIDIA_API_KEY=

# --- Volcano Ark (ByteDance) ---------------------------------------
# Shared by DeepSeek-V4-Pro, DeepSeek-V4.1-Flash, GLM-5.3-Flash.
# Used by providers/volcano.py
BYTEDANCE_API_KEY=

# --- OpenRouter (free tier) ----------------------------------------
# Used by providers/openrouter.py
OPENROUTER_API_KEY=

# --- OpenAI Platform API (BYOK) ------------------------------------
# Separate from ChatGPT Plus/GO subscriptions. Sign up at
# https://platform.openai.com/api-keys. Used by providers/openai.py.
OPENAI_API_KEY=

# --- Anthropic Claude API (BYOK) -----------------------------------
# Separate from Claude Code or Cursor subscriptions. Sign up at
# https://console.anthropic.com. Used by providers/claude.py.
ANTHROPIC_API_KEY=

# --- Ollama (no auth, local HTTP) ----------------------------------
# Both home machines are reached over Tailscale, not the LAN: the router
# often runs on a cloud VM that cannot route to 192.168.x.x.
#   MAC_IP     -> your Mac's Tailscale IP     (`tailscale ip -4` on the Mac)
#   SURFACE_IP -> your Surface's Tailscale IP (`tailscale ip -4` on the Surface)
# Ollama must also listen past loopback on each machine, or the connection
# is refused:  OLLAMA_HOST=0.0.0.0:11434
# Tip: run `bash scripts/setup_ollama.sh --surface --ip <addr>` to set this automatically.
MAC_IP=
SURFACE_IP=

# --- OpenAI-compatible long tail (providers/openai_compat.py) -------
# Leave blank to skip the pool gracefully.
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
HF_API_KEY=

# --- Server / runtime (all optional; defaults shown) ----------------
# OpenAI-compatible API (khavis-serve). Set KHAVIS_API_KEY to require
# `Authorization: Bearer <key>`; strongly recommended if KHAVIS_HOST is
# not loopback.
# KHAVIS_HOST=127.0.0.1
# KHAVIS_PORT=8080
# KHAVIS_API_KEY=
# KHAVIS_FAILOVER=1
# KHAVIS_SESSION=openai-api
# KHAVIS_HEALTH_REFRESH_S=60
# KHAVIS_PROVIDER_TIMEOUT_S=60
# KHAVIS_CONFIG_DIR=./config
# KHAVIS_LOG_DIR=logs
# KHAVIS_AUDIT_FILE=
# RAG backends (core/rag.py)
# KHAVIS_RAG_BACKEND=
# KHAVIS_RAG_DIR=.rag/chroma
# QDRANT_URL=http://127.0.0.1:6333
# PGVECTOR_DSN=
#
# Telegram bot variables (BOT_TOKEN, WEBHOOK_SECRET, ALLOWED_CHAT_IDS, …)
# live in deploy/.env.example.

# --- Tencent Cloud K.A.V.I.S. node (openclaw × hermes) --------------
# 遠端節點健康探測基底 URL（任何 HTTP 回應都視為在線；留空用內建預設，
# 即騰訊雲 443 的 khavis 狀態頁，自簽憑證不影響探測）
# KAVIS_TENCENT_ENDPOINT=https://your-kavis-node.example.com
# 派工通道：OpenAI 相容 /chat/completions 端點。未設定時節點僅做監控，
# 派工會回「通道未開通」而不會靜默失敗。
# KAVIS_TENCENT_DISPATCH_URL=
# KAVIS_TENCENT_API_KEY=
# KAVIS_TENCENT_MODEL=MiniMax-M3
