# Caddyfile for khavis-bot.
#
# Behaviour:
#   - With ``deploy/certs/bot.example.com/{fullchain,privkey}.pem`` mounted
#     into the container at /etc/caddy/certs/bot.example.com/: Caddy
#     serves the existing cert.
#   - Without the mount: Caddy auto-issues via ACME HTTP-01. Requires
#     ports 80 + 443 to be reachable from the public internet during
#     the first request.
#
# For Cloudflare-fronted tenants or on VPS providers that block inbound
# 80/443, add a Cloudflare DNS module and switch ``on-demand`` to
# DNS-01 — see https://caddyserver.com/docs/automatic-https#on-demand.

{
    email admin@example.com
}

# On-demand TLS requires this block to be reachable from Let's Encrypt.
bot.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080

    @cert_files {
        expression {env.CERT_FILES_PRESENT}
    }
    tls @cert_files /etc/caddy/certs/bot.example.com/fullchain.pem /etc/caddy/certs/bot.example.com/privkey.pem

    log {
        output stdout
        format console
    }
}

# HTTP→HTTPS redirect.
:80 {
    redir https://{host}{uri} permanent
}