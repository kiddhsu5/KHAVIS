# Example environment file for the K.H.A.V.I.S. Telegram bot.
# Copy to `.env` at the project root and fill in real values.
#
# All values below are read by `bot.secrets.BotSecrets.from_env()` and
# `docker-compose.yml`. NEVER commit a populated .env.

# Keep comments on their own line: some loaders (docker-compose env_file,
# naive shell parsers) treat "KEY=   # note" as KEY="# note" or KEY="".

# ----- Required -----
# Bot token from @BotFather.
BOT_TOKEN=

# Required in webhook mode (ignored in polling mode). 1-256 chars of
# [A-Za-z0-9_-] — Telegram's secret_token rules; the bot refuses to start
# otherwise. It no longer falls back to BOT_TOKEN. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# and pass the same value to setWebhook as secret_token=...
WEBHOOK_SECRET=

# Comma-separated integer chat IDs allowed to invoke the bot.
ALLOWED_CHAT_IDS=

# ----- Optional -----
# "webhook" (default) or "polling" for local / no-public-endpoint setups.
# BOT_MODE=webhook
# BOT_HOST=0.0.0.0
# BOT_PORT=8080
# BACKEND_TIMEOUT_S=180
# LONG_POLL_TIMEOUT_S=30
# Max updates handled concurrently (each runs as a background task).
# BOT_MAX_CONCURRENCY=4
# Bot @username (without @). When set, "/cmd@OtherBot" in groups is ignored.
# BOT_USERNAME=

# Restrict which backends `/run` fans out to when no --only flag is
# given. Comma-separated subset of: claude, codex, khavis.
# Unset / empty = all three. Useful to skip a backend that's
# temporarily unauthenticated (e.g. claude before OAuth login).
# BOT_BACKENDS=codex,K.H.A.V.I.S.

# Backend-specific defaults — leave empty to use each CLI's own default.
# CLAUDE_DISPATCH_MODEL=
# CODEX_DISPATCH_MODEL=

# For pair-loader (optional, points at the historical telegram-pairing.json)
# TELEGRAM_PAIRING_PATH=/path/to/telegram-pairing.json

# ----- Webhook Alerting & Quota Tracking -----
# Webhook URL (Slack, Discord, Telegram, or custom HTTP endpoint)
# KHAVIS_WEBHOOK_URL=https://hooks.slack.com/services/...
# Alert debounce cooldown window in seconds (default: 300)
# KHAVIS_ALERT_COOLDOWN_S=300
# Master switch for alert dispatching (1 or 0)
# KHAVIS_ALERTING=1

# ----- Local Ollama Safeguard -----
# Enable seamless fallback to local Ollama when all cloud APIs fail (1 or 0)
# KHAVIS_LOCAL_FALLBACK=1
# Preferred fallback model to auto-pull
# OLLAMA_FALLBACK_MODEL=gemma4:e2b
# Tailscale or container network host addresses for local Ollama nodes
# MAC_IP=ollama
# SURFACE_IP=ollama
